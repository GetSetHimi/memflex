# Memflex env — copy to .env (NEVER commit real keys; this file ships empty)
# API auth: empty = open local mode. Set to lock every route but /health
# (clients send X-API-Key header, or Authorization: Bearer).
MEMFLEX_API_KEY=
# REFLEX_API_KEY=            # legacy alias, also accepted
# CORS origins for hosted console (comma-separated). Default * = local dev.
# CORS_ORIGINS=https://console.memflex.dev
# LLM gateway (all optional — Mock is used when no keys/host reachable)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Ollama Cloud key (https://ollama.com/settings/keys) — enables ollama-cloud/* models, no local install.
# Hosted endpoint: https://ollama.com/api with Bearer auth. NEVER commit a real key.
OLLAMA_API_KEY=
# Upstream System-2 keys (ALL optional — missing key falls back to Mock, never crashes)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted as fallback for Gemini
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_LLM_MODEL=mock/mock-echo
# Embeddings: bge-m3 (default) | qwen3 | ollama/nomic-embed-text | hash (keyless fallback)
EMBEDDING_BACKEND=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
OLLAMA_EMBED_MODEL=nomic-embed-text
# Thresholds
SERVE_THRESHOLD=0.85
UNCERTAIN_BAND=0.65
# Confidence weights
W_SIM=0.6
W_HIT=0.2
W_RECENCY=0.1
W_CORRECTION=0.5
# Store: sqlite (default, 1 file, zero deps) | postgres (scale-out)
# REFLEX_STORE=postgres
# REFLEX_POSTGRES_DSN=postgresql://memflex:changeme@db:5432/memflex
REFLEX_DB_PATH=./data/reflex.db
REFLEX_TTL_DAYS=30
# Verify loop
VERIFY_INTERVAL_H=24
VERIFY_BATCH=20
# Pricing (for /metrics ₹ saved estimate per LLM call avoided)
COST_PER_LLM_CALL_INR=0.011
# Public demo lockdown (demo API host sets these; self-host leaves them off)
# DEMO_MODE=true
# DEMO_MODELS=mock/*,openrouter/nvidia/nemotron-3.5-lightning:free
# DEMO_RATE_PER_MIN=30
# DEMO_MAX_CHARS=300
